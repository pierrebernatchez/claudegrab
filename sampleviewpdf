#!/usr/bin/env bash
#
set -eo pipefail # had to remove th -u to stop bash evaluating "help" as a variable
#
# This is a convenience script for reviewing pdf files.
# It is full of special case exceptions to handle the idiosyncharcies of
# the file and directory name structure of the curren actual repository.
# A bit of a dog's breakfast. DO NOT TAKE IT AS A GENERALLY REUSABLE SCRIPT.
# 
#
# bash trick to obtain a clean absolute path to this script.
#
SCRIPTPATH="$(dirname ${0})"
pushd  "${SCRIPTPATH}" >/dev/null
SCRIPTPATH=`pwd -P`
popd >/dev/null
echo mypath ${SCRIPTPATH}
SCRIPTNAME="$(basename ${0})"
#
####
#### default language, override per-run with -l en|fr
####
MYLANG="en"     
####
#
# -l en|fr : optionally override MYLANG for this run
while getopts ":l:" opt; do
    case "$opt" in
        l) MYLANG="$OPTARG" ;;
        \?) echo "${SCRIPTNAME}: invalid option -$OPTARG" >&2; exit 1 ;;
        :) echo "${SCRIPTNAME}: -$OPTARG requires an argument (en or fr)" >&2; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

if [[ "${MYLANG}" != "en" && "${MYLANG}" != "fr" ]] ; then
    echo "${SCRIPTNAME}: invalid -l value '${MYLANG}' (must be en or fr)" >&2
    exit 1
fi
#
NLESSON="${1:-1}"
##
## Derive these variable values from
## their position in the filesystem
##
MYCOURSEDIR=$(dirname ${SCRIPTPATH})
MYCOURSE=$(basename ${MYCOURSEDIR})
SCRIPTPATHBASE=$(basename ${SCRIPTPATH})
echo scriptbase "$SCRIPTPATHBASE"
# 2026-10-26 directory-naming retrofit: every -pdfs/ directory's basename
# is now <2-char course prefix><2-char unit-or-fc token>-pdfs (afu2-pdfs,
# cvfc-pdfs, ...) -- chars 3-4 are always the bare unit-or-fc token
# regardless of course.
UNITTOKEN="${SCRIPTPATHBASE:2:2}"
if [[ "$MYCOURSE" == "g12-advanced-functions" ]] ; then
    # af's filenames deliberately carry no course prefix (see CLAUDE.md's
    # "Course layer"): unit1 stays fully bare, unit2-7/fc carry only the
    # bare unit-or-fc token.
    if [[ "$UNITTOKEN" == "u1" ]] ; then
        UNIT=""
    else
        UNIT="$UNITTOKEN"
    fi
else
    # cv's filenames carry the full course+unit prefix.
    UNIT="${SCRIPTPATHBASE:0:4}"
fi



DOHELP="False"
# Bash bending over backwards to work numbers
if [[ "${NLESSON}" -gt "0" && "${NLESSON}" -lt "13" ]] ; then
    NLESSON=$(expr $NLESSON + 0)
else
    NLESSON="1"
    DOHELP="True"
fi
###

# SCRIPTPATH is already the real, resolved location of this -pdfs/
# directory (that's what pushd+pwd -P above computed) -- no need to
# reconstruct it from MYCOURSE/UNIT guesses, which is fragile across
# naming-scheme changes. This is only used for the --help display text
# below, not for actual file lookups (those use SCRIPTPATH directly).
PSUBDIR="${SCRIPTPATH}"

if ! [[ -d "${PSUBDIR}" ]] ; then
    echo INVALID:
    echo "    " unit "${UNIT}"
    echo "    " mycoursedir "$MYCOURSEDIR"    
    echo "    " pdfs subdirectory: "${PSUBDIR}"
    echo "MUST BE INVOKING the script in an inappropriate directory"
    exit 1
fi

### Make up our list of eligible files to view
PBA="${UNIT}lesson0${NLESSON}-${MYLANG}.pdf"
PSA="${UNIT}lesson0${NLESSON}-solutions-${MYLANG}.pdf"
PBB="${UNIT}worksheet0${NLESSON}-${MYLANG}.pdf"
PSB="${UNIT}worksheet0${NLESSON}-solutions-${MYLANG}.pdf"
PBC="${UNIT}review0${NLESSON}-${MYLANG}.pdf"
PSC="${UNIT}review0${NLESSON}-solutions-${MYLANG}.pdf"
PBX="${UNIT}exam0${NLESSON}-${MYLANG}.pdf"
PSX="${UNIT}exam0${NLESSON}-solutions-${MYLANG}.pdf"
# note if you use PLC or PSC be sure nlesson is the correct number for it
# add/remove lines here to affect what is viewed
pdfstoview () {
    [[ -r "${SCRIPTPATH}/$PBA" ]] && echo -e "${SCRIPTPATH}/$PBA"
    [[ -r "${SCRIPTPATH}/$PSA" ]] && echo -e "${SCRIPTPATH}/$PSA"
    [[ -r "${SCRIPTPATH}/$PBB" ]] && echo -e "${SCRIPTPATH}/$PBB"
    [[ -r "${SCRIPTPATH}/$PSB" ]] && echo -e "${SCRIPTPATH}/$PSB"
    [[ -r "${SCRIPTPATH}/$PBC" ]] && echo -e "${SCRIPTPATH}/$PBC"
    [[ -r "${SCRIPTPATH}/$PSC" ]] && echo -e "${SCRIPTPATH}/$PSC"
    [[ -r "${SCRIPTPATH}/$PBX" ]] && echo -e "${SCRIPTPATH}/$PBX"
    [[ -r "${SCRIPTPATH}/$PSX" ]] && echo -e "${SCRIPTPATH}/$PSX"
}

mapfile -t viewablepdfs < <(pdfstoview)
##
##
 
SCRIPTNAME="$(basename ${0})"

if [[ "True" == "${DOHELP}" ]] ; then
    cat <<EOF
${SCRIPTNAME}:

    Use: ${SCRIPTNAME} [-l en|fr] NLESSON

    This is a convenience script we use to open one or more .pdf files for review.
    These are parameter values derived from the current defaults in "${SCRIPTNAME}":
        "${PSUBDIR}"
        "${PBA} ${PBB} ${PBC}"
        "${PSA} ${PSB} ${PSC}"
    You can:
        pass -l en or -l fr to override the language for this run (currently ${MYLANG}).
    Currently:
EOF
for aname in "${viewablepdfs[@]}"; do
    echo "        " $aname
done 
    exit 1
fi
for aname in "${viewablepdfs[@]}"; do
    echo "        " $aname
    xdg-open "$aname"
    sleep 1
done 
