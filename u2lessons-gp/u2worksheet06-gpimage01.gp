### u2worksheet06-gpimage01.gp
### Q2a solutions graph: y = (x+3)(x-2), zeros -3 and 2. Solutions-only.
### Regenerated with shading (item 7 follow-up, see review-notes.md) --
### generated by inequality_graph.py, see that file's docstring for the
### explicit-polygon technique and why it's used instead of gnuplot's
### automatic curve-to-axis fill.
set terminal pngcairo size 460,420 enhanced font "Arial,12"
set output '../u2lessons-media/u2worksheet06-gpimage01.png'

set xrange [-6.0:6.0]
set yrange [-10.0:10.0]

set xzeroaxis
set yzeroaxis

set xlabel "x"
set ylabel "y" rotate by 0
set grid

set xtics 1
set ytics 2
set mxtics 2
set mytics 2

unset key

f(x) = (1.0)*x**2 + (1.0)*x + (-6.0)

set style fill transparent solid 0.3 noborder
set style arrow 1 head filled size screen 0.02,20 lw 3 lc rgb "#cc3333"
set arrow 1 from -3.0,0 to -6.0,0 as 1
set arrow 2 from 2.0,0 to 6.0,0 as 1

plot '-' using 1:2 with filledcurves closed lc rgb "#cc3333" notitle, \
     '-' using 1:2 with filledcurves closed lc rgb "#cc3333" notitle, \
     f(x) with lines lw 2.5 lc rgb "#cc3333" notitle, \
     '-' using 1:2 with points pt 7 ps 1.3 lc rgb "black" notitle
