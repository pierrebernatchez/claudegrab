### u2worksheet06-gpimage02.gp
### Q2b solutions graph: y = (x+2)(3-x)(x+1) = -x^3+7x+6, zeros -2, -1, 3,
### negative leading coefficient. Solutions-only. Regenerated with shading
### (item 7 follow-up, see review-notes.md) -- generated by
### inequality_graph.py. Note: the -2<x<-1 region's shading is real but
### small (curve only dips to about y=-1.1 there) relative to this
### figure's y-range (-30 to 30, needed to fit the curve's much larger
### swing near the frame edges) -- confirmed against the original by
### direct comparison, not a bug.
set terminal pngcairo size 460,420 enhanced font "Arial,12"
set output '../u2lessons-media/u2worksheet06-gpimage02.png'

set xrange [-5.0:6.0]
set yrange [-30.0:30.0]

set xzeroaxis
set yzeroaxis

set xlabel "x"
set ylabel "y" rotate by 0
set grid

set xtics 1
set ytics 5
set mxtics 2
set mytics 2

unset key

f(x) = (-1.0)*x**3 + (0.0)*x**2 + (7.0)*x + (6.0)

set style fill transparent solid 0.3 noborder
set style arrow 1 head filled size screen 0.02,20 lw 3 lc rgb "#cc3333"
set arrow 1 from 3.0,0 to 6.0,0 as 1

plot '-' using 1:2 with filledcurves closed lc rgb "#cc3333" notitle, \
     '-' using 1:2 with filledcurves closed lc rgb "#cc3333" notitle, \
     f(x) with lines lw 2.5 lc rgb "#cc3333" notitle, \
     '-' using 1:2 with points pt 7 ps 1.3 lc rgb "black" notitle
