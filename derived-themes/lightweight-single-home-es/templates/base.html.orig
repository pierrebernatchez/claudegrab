<!DOCTYPE html>
<html lang="{{ DEFAULT_LANG }}">
<head>
  <title>{% block title %}{{ SITENAME }}{%endblock%}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <link rel="stylesheet" href="{{ SITEURL }}/theme/css/main.css" type="text/css" />
  {% if MYLANG_FEED_ATOM %}
    <link href="{{ SITEURL }}/{{ MYLANG_FEED_ATOM }}" type="application/atom+xml" rel="alternate" title="{{ SITENAME }} Spanish Atom Feed" />
  {% endif %}
  {% if MYLANG_FEED_RSS %}
    <link href="{{ SITEURL }}/{{ MYLANG_FEED_RSS }}" type="application/rss+xml" rel="alternate" title="{{ SITENAME }} Spanish RSS Feed" />
  {% endif %}
  {% if GOOGLE_ANALYTICS %}
  <script type="text/javascript">
    var gaJsHost = (("https:" == document.location.protocol) ? "https://ssl." : "http://www.");
    document.write(unescape("%3Cscript src='" + gaJsHost + "google-analytics.com/ga.js' type='text/javascript'%3E%3C/script%3E"));
    </script>
    <script type="text/javascript">
    try {
        var pageTracker = _gat._getTracker("{{GOOGLE_ANALYTICS}}");
    pageTracker._trackPageview();
    } catch(err) {}</script>
  {% endif %}
</head>
<body>
<div id="page">

  <header id="header">
    <h1><a href="{{ SITEURL }}/index.html">{{ SITENAME }}</a></h1>
  </header>

{% include 'menu.html' %}

  <section id="content">
{% block content %}
{% endblock %}
  </section> <!-- /#content -->

{% include 'sidebar.html' %}

  <footer id="footer">

    {% if page is defined and page.fcopyright %}
        <p>{{ page.fcopyright }}</p>
    {% elif article is defined and article.fcopyright %}
        <p>{{ article.fcopyright }}</p>
    {% else %}
        <p>Derechos de autor © 2015-2026 Pierre Bernatchez—todos los derechos reservados.</p>
    {% endif %}
    
    <p>Desarrollado por <a href="http://getpelican.com/">Pelican</a>, aprovechando <a href="https://www.python.org/">Python</a>. Con el tema <a href="https://github.com/getpelican/pelican-themes" target="_blank">lightweight</a>.</p>

    <p>Feed de todos los artículos
      {% if MYLANG_FEED_ATOM %}
       Atom <a href="{{ SITEURL }}/{{ MYLANG_FEED_ATOM }}"><img alt="Feed icon" src="{{ SITEBUCKETURL }}/images/RSScom-icon.svg" style="width: 16px;" /></a>
       {% endif %}
       {% if MYLANG_FEED_RSS %}
       RSS <a href="{{ SITEURL }}/{{ MYLANG_FEED_RSS }}"><img alt="Feed icon" src="{{ SITEBUCKETURL }}/images/RSScom-icon.svg" style="width: 16px;" /></a>
       {% endif %}
    </p>
    
  </footer>
</div> <!-- /#page -->
</body>
</html>
